{
    "swagger": "2.0",
    "info": {
        "description": "APIs for creating and managing jobs",
        "title": "Jobs Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost",
    "basePath": "/jobs",
    "paths": {
        "/import-server": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "User uploads an Excel file with servers info, and the server will try to import valid servers",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Import servers from csv file",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Input servers file (CSV)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/jobs.CreateImportJobResponse"
                        }
                    }
                }
            }
        },
        "/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "After user uploads Excel file(s) with servers info for import, they can take the job's ID and check the status of processing in here",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Get a job's status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/jobs.GetJobResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "jobs.CreateImportJobResponse": {
            "type": "object",
            "properties": {
                "job_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "jobs.GetJobResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "failed_rows_count": {
                    "type": "integer"
                },
                "failures_file_url": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "input_file_url": {
                    "type": "string"
                },
                "processed_rows": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "success_rows_count": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type 'Bearer ' followed by your JWT token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}