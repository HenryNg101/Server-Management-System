{
    "swagger": "2.0",
    "info": {
        "description": "API for managing servers and users, and reporting",
        "title": "Server Management API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/servers": {
            "get": {
                "description": "Retrieve servers with filtering, pagination, and sorting",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Get servers",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Filter by status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by protocol",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search by name",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size (default 10, max 100)",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort by field (id, name, created_at)",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort order (asc, desc)",
                        "name": "order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.PaginatedServers"
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new server, with specifications",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Create a server",
                "parameters": [
                    {
                        "description": "Server payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.CreateServerRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.Server"
                        }
                    }
                }
            }
        },
        "/servers/export": {
            "get": {
                "description": "User ask for all servers info with optional filtering, pagination, and sorting, and the server will export servers info to CSV file",
                "produces": [
                    "text/csv"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Export servers info to csv file",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Filter by status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by protocol",
                        "name": "protocol",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search by name",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size (default 10, max 100)",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort by field (id, name, created_at)",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort order (asc, desc)",
                        "name": "order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CSV file",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "Content-Disposition": {
                                "type": "string",
                                "description": "attachment; filename=servers.csv"
                            }
                        }
                    }
                }
            }
        },
        "/servers/import": {
            "post": {
                "description": "User uploads an Excel file with servers info, and the server will try to import valid servers",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Import servers from csv file",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.ImportServersResponse"
                        }
                    }
                }
            }
        },
        "/servers/report": {
            "get": {
                "description": "Retrieve servers statuses within a time range",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Get status report on the servers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.Report"
                        }
                    }
                }
            }
        },
        "/servers/{id}": {
            "get": {
                "description": "Retrieve a server based on ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Get a server",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Server"
                        }
                    }
                }
            },
            "delete": {
                "description": "Get a server based on ID, and delete that server",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Delete a server",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            },
            "patch": {
                "description": "Get a server based on ID, and then update field(s)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Update a server",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "New server info",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.UpdateServerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Server"
                        }
                    }
                }
            }
        },
        "/users": {
            "get": {
                "description": "Retrieve list of users",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get all users",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.User"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new user, with specifications",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Create a user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.User"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.Membership": {
            "type": "object",
            "properties": {
                "server": {
                    "$ref": "#/definitions/model.Server"
                },
                "serverID": {
                    "type": "integer"
                },
                "user": {
                    "$ref": "#/definitions/model.User"
                },
                "userID": {
                    "type": "integer"
                },
                "userRole": {
                    "type": "string"
                }
            }
        },
        "model.Server": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "description": "Automatically managed by GORM for creation time",
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "ipv4Address": {
                    "description": "IPv4 of the server",
                    "type": "string"
                },
                "lastUpdated": {
                    "description": "Last time the server got updated",
                    "type": "string"
                },
                "memberships": {
                    "description": "Manage many-to-many relationship between servers and users",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Membership"
                    }
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "description": "Port of the server",
                    "type": "integer"
                },
                "protocol": {
                    "description": "Network protocol that the server use, could be TCP, FTP, SSH, etc.",
                    "type": "string"
                },
                "status": {
                    "description": "Server status at the time (Is it on or off)",
                    "type": "boolean"
                }
            }
        },
        "model.User": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "memberships": {
                    "description": "Manage many-to-many relationship between servers and users",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Membership"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "server.CreateServerRequest": {
            "type": "object",
            "required": [
                "ipv4_address",
                "name",
                "port",
                "status"
            ],
            "properties": {
                "ipv4_address": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "protocol": {
                    "type": "string"
                },
                "status": {
                    "type": "boolean"
                }
            }
        },
        "server.ImportFailure": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "record": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "row": {
                    "type": "integer"
                }
            }
        },
        "server.ImportServersResponse": {
            "type": "object",
            "properties": {
                "failed_count": {
                    "type": "integer"
                },
                "failures": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/server.ImportFailure"
                    }
                },
                "success_count": {
                    "type": "integer"
                },
                "successes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Server"
                    }
                }
            }
        },
        "server.PaginatedServers": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
                },
                "servers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Server"
                    }
                },
                "total": {
                    "type": "integer"
                },
                "total_pages": {
                    "type": "integer"
                }
            }
        },
        "server.Report": {
            "type": "object",
            "properties": {
                "servers_down": {
                    "type": "integer"
                },
                "servers_up": {
                    "type": "integer"
                },
                "total_servers": {
                    "type": "integer"
                },
                "uptime_per_server": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                }
            }
        },
        "server.UpdateServerRequest": {
            "type": "object",
            "properties": {
                "ipv4": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "protocol": {
                    "type": "string"
                },
                "status": {
                    "type": "boolean"
                }
            }
        }
    }
}