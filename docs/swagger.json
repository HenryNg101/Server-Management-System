                "record": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "row": {
                    "type": "integer"
                }
            }
        },
        "server.ImportServersResponse": {
            "type": "object",
            "properties": {
                "failed_count": {
                    "type": "integer"
                },
                "failures": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/server.ImportFailure"
                    }
                },
                "success_count": {
                    "type": "integer"
                },
                "successes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Server"
                    }
                }
            }
        },
