{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/servers": {
            "get": {
                "description": "Retrieve list of suitable servers based on filters",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Get servers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Server"
                            }
                        }
                    }
                }
            }
        },
        "/servers/:id": {
            "get": {
                "description": "Retrieve a server based on ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Get a server",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Server"
                        }
                    }
                }
            },
            "delete": {
                "description": "Get a server based on ID, and delete that server",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Delete a server",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            },
            "patch": {
                "description": "Get a server based on ID, and then update field(s)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Update a server",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Server"
                        }
                    }
                }
            }
        },
        "/servers/import": {
            "post": {
                "description": "User uploads an Excel file with servers info, and the server will try to import valid servers",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "servers"
                ],
                "summary": "Import servers from csv file",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.ImportServersResponse"
                        }
                    }
                }
            }
        },
        "/users": {
            "get": {
                "description": "Retrieve list of users",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get all users",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.User"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new user, with specifications",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Create a user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.User"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.Membership": {
            "type": "object",
            "properties": {
                "server": {
                    "$ref": "#/definitions/model.Server"
                },
                "serverID": {
                    "type": "integer"
                },
                "user": {
                    "$ref": "#/definitions/model.User"
                },
                "userID": {
                    "type": "integer"
                },
                "userRole": {
                    "type": "string"
                }
            }
        },
        "model.Server": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "description": "Automatically managed by GORM for creation time",
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "ipv4Address": {
                    "description": "IPv4 of the server",
                    "type": "string"
                },
                "lastUpdated": {
                    "description": "Last time the server got updated",
                    "type": "string"
                },
                "memberships": {
                    "description": "Manage many-to-many relationship between servers and users",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Membership"
                    }
                },
                "name": {
                    "type": "string"
                },
                "port": {
                    "description": "Port of the server",
                    "type": "integer"
                },
                "protocol": {
                    "description": "Network protocol that the server use, could be TCP, FTP, SSH, etc.",
                    "type": "string"
                },
                "status": {
                    "description": "Server status at the time (Is it on or off)",
                    "type": "boolean"
                }
            }
        },
        "model.User": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "memberships": {
                    "description": "Manage many-to-many relationship between servers and users",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Membership"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "server.ImportFailure": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "record": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "row": {
                    "type": "integer"
                }
            }
        },
        "server.ImportServersResponse": {
            "type": "object",
            "properties": {
                "failed_count": {
                    "type": "integer"
                },
                "failures": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/server.ImportFailure"
                    }
                },
                "success_count": {
                    "type": "integer"
                },
                "successes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Server"
                    }
                }
            }
        }
    }
}